{
  "expo": {
    "name": "Bitácora Digital de Redes",
    "slug": "bitacora-redes",
    "scheme": "bitacoraredes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eduardo_rivass.bitacoraredes"
    },
    "web": {
      "favicon": "./assets/logobitacoraredes.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "5f881cff-e1e2-47d3-b115-bbab90cd8ff3"
      }
    }
  }
}
